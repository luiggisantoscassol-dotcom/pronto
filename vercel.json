{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://eegqobqhrfdkmjyjnqvp.supabase.co/functions/v1/sitemap"
    },
    {
      "source": "/produtos/:slug",
      "destination": "https://eegqobqhrfdkmjyjnqvp.supabase.co/functions/v1/produto-seo?slug=:slug"
    },
    {
      "source": "/cachaca-porto-alegre",
      "destination": "/cachaca-porto-alegre.html"
    }
  ],
  "headers": [
    {
      "source": "/fotos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(otf|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400" }
      ]
    }
  ]
}
